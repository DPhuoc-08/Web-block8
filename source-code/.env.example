# Sao chép file này thành .env rồi điền giá trị thật (không commit .env).

# Database: CHÍNH project Supabase của block7 (đã chốt). Supabase → Connect → Session pooler, cổng 5432.
# Seed của block8 xoá sạch rồi tạo lại dữ liệu của database đang trỏ tới (dữ liệu block7 ra y hệt vì seed tất định).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"
PORT=3000

# Bật để in từng câu SQL thật (kèm tham số) ra terminal — dùng làm bằng chứng nộp. Mặc định tắt.
# LOG_SQL=1

# Địa chỉ gốc của ứng dụng: dựng link trong email (không lấy từ header Host) và so với header Origin (chống CSRF).
APP_ORIGIN=http://localhost:3000

# Bí mật ký cookie phiên (express-session) và "pepper" của mã OTP. Chuỗi ngẫu nhiên dài, tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
OTP_PEPPER=

# Tài khoản seed (đã kích hoạt). Nên dùng Gmail của nhóm với dấu + để cả hai về một hộp thư (plan 12.2.c),
# ví dụ ten+viewer@gmail.com, ten+admin@gmail.com. Mật khẩu 8–64 ký tự.
SEED_VIEWER_EMAIL=
SEED_ADMIN_EMAIL=
SEED_USER_PASSWORD=

# Gửi email: smtp (Gmail, khi demo) hoặc file (ghi .eml vào .mail-outbox/ cho script kiểm tra).
MAIL_TRANSPORT=file
MAIL_FROM="Nhà hàng <dia-chi-gmail-gui@gmail.com>"
# Gmail SMTP: tài khoản bật xác minh 2 bước → Google Account → Security → App passwords.
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v2 checkbox: tạo key tại https://www.google.com/recaptcha/admin, thêm domain localhost.
# Site key công khai (in vào trang); secret key chỉ ở đây. RECAPTCHA_HOSTNAMES: hostname được chấp nhận trong kết quả siteverify.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=localhost
