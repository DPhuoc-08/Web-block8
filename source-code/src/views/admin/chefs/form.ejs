<%- include("../../partials/header", { title }) %>
<%# Form thêm / sửa đầu bếp — chuyển từ ChefFormPage.jsx của block7. Chuyên môn: nút viên tag (≥ 1) + tag mới tạo khi lưu. -%>
<% const err = (k) => errors[k] ? " invalid" : ""; -%>
<a class="back" href="<%= back %>">← Danh sách đầu bếp</a>
<div class="panel form-panel">
  <h1><%= id ? "Sửa đầu bếp" : "Thêm đầu bếp" %></h1>
<% if (id) { %>  <p class="muted no-margin">Đầu bếp #<%= id %></p>
<% } if (Object.keys(errors).length) { %>  <p class="alert" role="alert" data-focus-first-error>Dữ liệu chưa hợp lệ, vui lòng sửa các trường bên dưới.</p>
<% } -%>
  <form class="form" method="post" action="<%= id ? `/admin/chefs/${id}?_method=PATCH` : "/admin/chefs" %>" novalidate data-once data-unsaved-guard>
    <input type="hidden" name="back" value="<%= back %>">
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label class="field<%= err("name") %>">
      <span>Tên đầu bếp</span>
      <input name="name" value="<%= values.name %>">
<% if (errors.name) { %>      <span class="error"><%= errors.name %></span>
<% } -%>
    </label>
    <fieldset class="choice-group<%= err("tagIds") || err("newTags") %>">
      <legend>Chuyên môn <small class="muted">(chọn ít nhất 1)</small></legend>
<% if (errors.tagIds) { %>      <p class="error"><%= errors.tagIds %></p>
<% } -%>
      <div class="pill-list">
<% for (const t of tags) { -%>
        <label class="pill-choice"><input type="checkbox" name="tagIds" value="<%= t.id %>"<% if (values.tagIds.includes(String(t.id))) { %> checked<% } %>><span><%= t.name %></span></label>
<% } -%>
      </div>
      <label class="field quick-new<%= err("newTags") %>">
        <span>Tag mới <small class="muted">(nếu chưa có trong danh sách)</small></span>
        <input name="newTags" value="<%= values.newTags %>" placeholder="Cách nhau bằng dấu phẩy" autocomplete="off">
<% if (errors.newTags) { %>        <span class="error"><%= errors.newTags %></span>
<% } -%>
      </label>
    </fieldset>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-busy-label="Đang lưu…"><%= id ? "Lưu" : "Thêm" %></button>
      <a class="btn" href="<%= back %>">Huỷ</a>
    </div>
  </form>
</div>
<%- include("../../partials/footer") %>
