<%- include("../../partials/header", { title }) %>
<%# Đổi mật khẩu khi đang đăng nhập. Dùng lại ô nhập của trang tài khoản (có nút Hiện); mật khẩu KHÔNG BAO GIỜ được điền lại. -%>
<a class="back" href="/admin/profile">← Hồ sơ</a>
<div class="panel form-panel">
  <h1>Đổi mật khẩu</h1>
  <p class="muted no-margin">Các thiết bị khác sẽ bị đăng xuất, thiết bị này vẫn giữ đăng nhập.</p>
<% if (Object.keys(errors).length) { %>  <p class="alert" role="alert" data-focus-first-error>Chưa đổi được mật khẩu, vui lòng sửa các ô bên dưới.</p>
<% } -%>
  <form class="form" method="post" action="/admin/profile/password" novalidate data-once>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <%- include("../../auth/_field", { name: "currentPassword", label: "Mật khẩu hiện tại", type: "password", autocomplete: "current-password", error: errors.currentPassword, toggle: true }) %>
    <%- include("../../auth/_field", { name: "password", label: "Mật khẩu mới", type: "password", autocomplete: "new-password", error: errors.password, toggle: true, hint: "8–64 ký tự. Một câu dễ nhớ cũng được." }) %>
    <%- include("../../auth/_field", { name: "passwordConfirm", label: "Nhập lại mật khẩu mới", type: "password", autocomplete: "new-password", error: errors.passwordConfirm, toggle: true }) %>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-busy-label="Đang đổi…">Đổi mật khẩu</button>
      <a class="btn" href="/admin/profile">Huỷ</a>
    </div>
  </form>
</div>
<%- include("../../partials/footer") %>
