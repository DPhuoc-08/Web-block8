<%- include("../../partials/header", { title }) %>
<%# Xoá tag: đang được món hoặc đầu bếp dùng thì không có nút xoá (gửi thẳng → 409). Link tới danh sách đã lọc theo tên tag. -%>
<a class="back" href="/admin/tags">← Danh sách tag</a>
<div class="panel confirm">
  <h1>Xoá tag “<%= tag.name %>”?</h1>
<% if (error) { %>  <p class="alert" role="alert"><%= error %></p>
<% } -%>
<% if (dishCount === 0 && chefCount === 0) { -%>
  <p class="muted">Không món, không đầu bếp nào dùng tag này. Thao tác này không khôi phục được.</p>
  <form method="post" action="/admin/tags/<%= tag.id %>?_method=DELETE" class="form-actions" data-once>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <button type="submit" class="btn btn-danger" data-busy-label="Đang xoá…">Xoá</button>
    <a class="btn" href="/admin/tags">Huỷ</a>
  </form>
<% } else { -%>
  <p>Không thể xoá: tag đang được <strong><%= dishCount %> món</strong> và <strong><%= chefCount %> đầu bếp</strong> dùng. Bỏ tag khỏi các món, đầu bếp đó rồi quay lại xoá.</p>
  <ul class="related-list">
<% if (dishCount > 0) { %>    <li><span>Món dùng tag này</span> <a href="/admin/dishes?<%= new URLSearchParams({ q: tag.name }) %>">Xem danh sách</a></li>
<% } if (chefCount > 0) { %>    <li><span>Đầu bếp dùng tag này</span> <a href="/admin/chefs?<%= new URLSearchParams({ q: tag.name }) %>">Xem danh sách</a></li>
<% } -%>
  </ul>
  <a class="btn" href="/admin/tags">Quay lại</a>
<% } -%>
</div>
<%- include("../../partials/footer") %>
