<%- include("../../partials/header", { title }) %>
<%# Form thêm / sửa tag. Lỗi nhập trả 400 và giữ giá trị đã gõ, như form nguyên liệu. -%>
<a class="back" href="/admin/tags">← Danh sách tag</a>
<div class="panel form-panel">
  <h1><%= id ? "Sửa tag" : "Thêm tag" %></h1>
<% if (id) { %>  <p class="muted no-margin">Tag #<%= id %></p>
<% } if (hasArtName) { %>  <p class="note">Đây là tag loại món có hình minh hoạ riêng. Đổi tên thì món sẽ dùng hình chung và tag không còn nằm trong nhóm nút hiện sẵn trên thực đơn.</p>
<% } if (Object.keys(errors).length) { %>  <p class="alert" role="alert" data-focus-first-error>Dữ liệu chưa hợp lệ, vui lòng sửa các trường bên dưới.</p>
<% } -%>
  <form class="form" method="post" action="<%= id ? `/admin/tags/${id}?_method=PATCH` : "/admin/tags" %>" novalidate data-once data-unsaved-guard>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label class="field<%= errors.name ? " invalid" : "" %>">
      <span>Tên tag</span>
      <input name="name" value="<%= values.name %>">
<% if (errors.name) { %>      <span class="error"><%= errors.name %></span>
<% } -%>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-busy-label="Đang lưu…"><%= id ? "Lưu" : "Thêm" %></button>
      <a class="btn" href="/admin/tags">Huỷ</a>
    </div>
  </form>
</div>
<%- include("../../partials/footer") %>
