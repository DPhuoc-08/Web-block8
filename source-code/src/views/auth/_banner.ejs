<%#
  Hộp thông báo đầu form (thành phần "Thông báo" trên Figma). banner = { kind: "error" | "info" | "success", text, link? }.
  Lỗi dùng role="alert" (đọc ngay), thông tin / thành công dùng role="status".
-%>
<% if (locals.banner) { const icons = { error: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>', info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>', success: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>' }; -%>
<div class="banner banner-<%= banner.kind %>" role="<%= banner.kind === "error" ? "alert" : "status" %>"<% if (banner.kind === "error") { %> data-focus-first-error<% } %>>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[banner.kind] %></svg>
  <p><%= banner.text %><% if (banner.link) { %> <a href="<%= banner.link.href %>"><%= banner.link.text %></a><% } %></p>
</div>
<% } -%>
