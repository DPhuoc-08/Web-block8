<%#
  Một ô nhập của trang tài khoản (thành phần "Ô nhập" trên Figma): nhãn luôn hiện, ô cao 48px, chữ 16px.
  Tham số: name, label, type ("text" | "email" | "password"), value, autocomplete, error, hint, link ({ href, text }),
  toggle (nút Hiện mật khẩu), inputmode, placeholder. Mật khẩu KHÔNG BAO GIỜ được điền lại (value bỏ qua).
-%>
<% const id = `f-${name}`; const isPw = type === "password"; const described = [locals.hint ? `${id}-hint` : null, locals.error ? `${id}-error` : null].filter(Boolean).join(" "); -%>
<div class="a-field<%= locals.error ? " invalid" : "" %>">
  <div class="a-label-row">
    <label for="<%= id %>"><%= label %></label>
<% if (locals.link) { %>    <a href="<%= link.href %>"><%= link.text %></a>
<% } -%>
  </div>
  <div class="a-control<%= locals.toggle ? " has-toggle" : "" %>">
    <input id="<%= id %>" name="<%= name %>" type="<%= type %>"<% if (!isPw && locals.value) { %> value="<%= value %>"<% } %> autocomplete="<%= autocomplete %>"<% if (locals.inputmode) { %> inputmode="<%= inputmode %>"<% } %><% if (locals.placeholder) { %> placeholder="<%= placeholder %>"<% } %><% if (locals.error) { %> aria-invalid="true"<% } %><% if (described) { %> aria-describedby="<%= described %>"<% } %><% if (type === "email") { %> autocapitalize="none" spellcheck="false"<% } %>>
<% if (locals.toggle) { -%>
    <button type="button" class="pw-toggle js-only" aria-controls="<%= id %>" aria-pressed="false" aria-label="Hiện mật khẩu"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><span>Hiện</span></button>
<% } -%>
  </div>
<% if (locals.hint) { %>  <p class="a-hint" id="<%= id %>-hint"><%= hint %></p>
<% } if (locals.error) { %>  <p class="a-error" id="<%= id %>-error"><%= error %></p>
<% } -%>
</div>
