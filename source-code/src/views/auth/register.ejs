<%- include("_start") %>
<%# Đăng ký (Figma vòng 2, màn 2): email, mật khẩu (quy tắc nói trước), nhập lại, reCAPTCHA. Không có ô role. -%>
<form class="auth-form" method="post" action="/register" novalidate data-once<% if (code) { %> data-error-code="<%= code %>"<% } %>>
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <div class="auth-head">
    <h1>Tạo tài khoản</h1>
    <p>Dùng email của bạn. Chúng tôi gửi mã 6 số để kích hoạt tài khoản.</p>
  </div>
  <%- include("_banner") %>
  <div class="auth-fields">
    <%- include("_field", { name: "email", label: "Email", type: "email", value: values.email, autocomplete: "email", placeholder: "ban@example.com", error: errors.email }) %>
    <%- include("_field", { name: "password", label: "Mật khẩu", type: "password", autocomplete: "new-password", placeholder: "Tạo mật khẩu", error: errors.password, toggle: true, hint: "8–64 ký tự. Một câu dễ nhớ cũng được." }) %>
    <%- include("_field", { name: "passwordConfirm", label: "Nhập lại mật khẩu", type: "password", autocomplete: "new-password", placeholder: "Nhập lại mật khẩu", error: errors.passwordConfirm, toggle: true }) %>
  </div>
  <%- include("_captcha") %>
  <button type="submit" class="btn btn-primary btn-block" data-busy-label="Đang tạo tài khoản…">Tạo tài khoản</button>
  <hr class="auth-divider">
  <p class="auth-foot">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</form>
<%- include("_end") %>
