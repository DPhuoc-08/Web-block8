<%# Hình nét mảnh của một loại món (dữ liệu hằng trong src/dish-art.js). Chỉ để trang trí → aria-hidden. -%>
<svg class="<%= cls %>" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><% for (const d of shape.d) { %><path d="<%= d %>"/><% } %><% for (const r of shape.rect ?? []) { %><rect x="<%= r.x %>" y="<%= r.y %>" width="<%= r.width %>" height="<%= r.height %>" rx="<%= r.rx %>"/><% } %><% for (const c of shape.circle ?? []) { %><circle cx="<%= c.cx %>" cy="<%= c.cy %>" r="<%= c.r %>"/><% } %><% for (const e of shape.ellipse ?? []) { %><ellipse cx="<%= e.cx %>" cy="<%= e.cy %>" rx="<%= e.rx %>" ry="<%= e.ry %>"/><% } %></svg>
